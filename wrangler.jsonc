{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swipeflix",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // The app itself (public/) is served by Cloudflare for free; only /api/* runs our code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // One-time device-transfer codes and counters against code-guessing. Never anyone's history or swipes.
  "durable_objects": { "bindings": [{ "name": "SHARED", "class_name": "Shared" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Shared"] }
  ],

  // Rate limit on every /api call, per visitor. Free, and works on workers.dev addresses where zone firewall rules do not.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "4721", "simple": { "limit": 60, "period": 60 } }
  ],

  "vars": {
    // Where the scheduled GitHub job publishes the catalogs (the `data` branch of your repo).
    "CATALOG_BASE": "https://raw.githubusercontent.com/kkotsop/movie-recommendation/data/catalog"
  },

  "observability": { "enabled": true }
}
