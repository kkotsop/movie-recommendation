{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swipeflick",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // The app itself (public/) is served by Cloudflare for free; only /api/* runs our code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Shared TMDB lookups, rate limits and device-transfer codes. Never anyone's history or swipes.
  "durable_objects": { "bindings": [{ "name": "SHARED", "class_name": "Shared" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shared"] }],

  "vars": {
    // Where the scheduled GitHub job publishes the country catalogs (the `data` branch of your repo).
    "CATALOG_BASE": "https://raw.githubusercontent.com/kkotsop/movie-recommendation/data/catalog"
  },

  "observability": { "enabled": true }

  // Optional secret, for recognising watched titles the catalog doesn't have (never in this file):
  //   npx wrangler secret put TMDB_API_KEY
}
