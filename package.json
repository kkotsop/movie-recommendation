{
  "name": "swipeflix",
  "version": "1.0.0",
  "description": "Swipe through Netflix recommendations built from your own viewing history and IMDb ratings. Your data stays on your phone. Runs on Cloudflare.",
  "type": "module",
  "main": "worker/index.js",
  "scripts": {
