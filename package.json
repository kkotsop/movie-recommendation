    "deploy": "wrangler deploy",
    "test": "node --test",
    "icons": "node scripts/make-icons.js",
    "catalogs": "node scripts/build-catalogs.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.50.0",
    "wrangler": "^4.152.0"
  }
}
